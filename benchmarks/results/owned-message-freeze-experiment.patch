+test('parser message freezing deeply traverses AST and contracts not trusted by core', () => {
+  const parsed = catalog({ x: '{n, plural, other {#}}' }).messages.x;
+  const received = JSON.parse(JSON.stringify(parsed));
+  Object.freeze(received.ast);
+  Object.freeze(received.arguments);
+  assert.equal(isDeepFrozen(received.ast), false);
+  assert.equal(isDeepFrozen(received.arguments), false);
+  assert.equal(freezeParsedMessage(received), received);
+  function verify(value) {
+    if (value === null || typeof value !== 'object') return;
+    assert.ok(Object.isFrozen(value) && isDeepFrozen(value));
+    for (const child of Object.values(value)) verify(child);
+  }
+  verify(received);
+  assert.deepEqual(received, JSON.parse(JSON.stringify(parsed)));
+  assert.throws(() => { received.arguments.n.acceptedTypes.push('string'); }, TypeError);
+  assert.throws(() => { received.ast[0].options.other.value.push({ type: 0, value: 'changed' }); }, TypeError);
