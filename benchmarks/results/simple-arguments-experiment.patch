   // Always walk first so a prior success cannot hide a message-local conflict.
   const signature = JSON.stringify([...types]);
+  return cacheArgumentSchema(signature, types, cache);
+}
+
+/** Successful simple parses contain only unconstrained ASCII arguments. */
+export function inferSimpleArguments(names: ReadonlySet<string>, cache: Map<string, MessageSchema>): MessageSchema {
+  const types: [string, ArgumentType[]][] = Array.from(names, name => [name, ['string', 'number']]);
+  return cacheArgumentSchema(JSON.stringify(types), types, cache);
+}
+
+function cacheArgumentSchema(signature: string, types: Iterable<[string, ArgumentType[]]>,
+  cache: Map<string, MessageSchema>,
+): MessageSchema {
   const cached = cache.get(signature);
   if (cached) return cached;
   const schema: Record<string, { required: true; acceptedTypes: ArgumentType[] }> = Object.create(null);
