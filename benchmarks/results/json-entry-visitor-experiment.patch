+test('JSON diagnostics outrank message errors discovered in earlier tokens', () => {
+  for (const [source, code, id] of [
+    ['{"bad":"{broken","x":"A","x":"B"}', 'DUPLICATE_ID', 'x'],
+    [String.raw`{"bad":"{broken","x":"A","\u0078":"B"}`, 'DUPLICATE_ID', 'x'],
+    ['{"bad":"{broken","x":3}', 'INVALID_CATALOG', 'x'],
+    ['{"a:b":"invalid ID","x":null}', 'INVALID_CATALOG', 'x'],
+    ['{"bad":"{n, number}{n, select, other {text}}","x":"A","x":"B"}', 'DUPLICATE_ID', 'x'],
+    ['{"x":"{broken","x":3}', 'INVALID_CATALOG', 'x'],
+    ['{"x":3,"x":"ok"}', 'INVALID_CATALOG', 'x'],
+    ['{"bad":"{broken","x":"A","x":"B","later":{}}', 'INVALID_CATALOG', 'later'],
+  ]) assert.throws(() => parseCatalog(source, options), error => {
+    assert.ok(error instanceof CatalogError);
+    assert.equal(error.diagnostics.length, 1);
+    assert.equal(error.diagnostics[0].code, code);
+    assert.equal(error.diagnostics[0].id, id);
+    return true;
+  });
+  const source = '{"bad":"{broken","a":"A","a":"B","b":"C","b":"D"}';
+  assert.throws(() => parseCatalog(source, options), error => {
+    assert.deepEqual(error.diagnostics.map(d => [d.code, d.id, d.position.offset]), [
+      ['DUPLICATE_ID', 'a', source.indexOf('"a":"B"')], ['DUPLICATE_ID', 'b', source.indexOf('"b":"D"')],
+    ]);
+    return true;
+  });
+});
