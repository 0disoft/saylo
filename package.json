{
  "name": "saylo-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "demo:lazy": "npm run build --workspace=@0disoft/saylo-core && node examples/lazy/main.mjs",
    "demo:ssr": "npm run build && node examples/ssr/demo.mjs",
    "bench:live": "npm run build && node benchmarks/live-update/run.mjs",
    "verify:pack": "npm run build && node scripts/pack-smoke.mjs",
    "verify:registry": "node scripts/pack-smoke.mjs --registry --registry-version 0.1.0-alpha.1",
    "verify:registry:alpha2": "node scripts/pack-smoke.mjs --registry --registry-version 0.1.0-alpha.2",
    "verify:registry:alpha3": "node scripts/pack-smoke.mjs --registry --registry-version 0.1.0-alpha.3",
    "verify:registry:sveltekit": "node scripts/pack-sveltekit.mjs --registry-version 0.1.0-alpha.2",
    "verify:registry:sveltekit:alpha3": "node scripts/pack-sveltekit.mjs --registry-version 0.1.0-alpha.3",
    "dev:ssr": "npm run build && node examples/ssr/server.mjs",
    "dev": "npm run build && vite --config examples/vanilla/vite.config.mjs --host 127.0.0.1",
    "build:demo": "npm run build && vite build --config examples/vanilla/vite.config.mjs",
    "dev:react": "npm run build && vite --config examples/react/vite.config.mjs --host 127.0.0.1",
    "typegen:react": "npm run build && node packages/typegen/dist/cli.js --locales-dir examples/vanilla/locales --base-locale ko --out-file examples/react/generated.d.ts",
    "build:react": "npm run typegen:react && tsc -p examples/react/tsconfig.json && vite build --config examples/react/vite.config.mjs",
    "dev:svelte": "npm run build && vite --config examples/svelte/vite.config.mjs --host 127.0.0.1",
    "typegen:svelte": "npm run build && node packages/typegen/dist/cli.js --locales-dir examples/svelte/locales --base-locale ko --out-file examples/svelte/generated.d.ts",
    "build:svelte": "npm run typegen:svelte && tsc -p examples/svelte/tsconfig.json && vite build --config examples/svelte/vite.config.mjs",
    "setup:sveltekit": "npm run build && node scripts/setup-sveltekit.mjs",
    "dev:sveltekit": "npm --prefix examples/sveltekit run dev",
    "build:sveltekit": "npm --prefix examples/sveltekit run build",
    "verify:sveltekit": "npm --prefix examples/sveltekit run verify:ssr",
    "verify:pack:sveltekit": "npm run build && node scripts/pack-sveltekit.mjs",
    "test": "npm run build && npm run test --workspaces",
    "check": "npm run verify:boundaries && npm run build && npm run test --workspaces && npm run typecheck:consumers --workspaces && node packages/typegen/dist/cli.js --locales-dir examples/vanilla/locales --base-locale ko --out-file examples/react/generated.d.ts && tsc -p examples/react/tsconfig.json && node --test scripts/test/verify-oidc.test.mjs scripts/test/registry-release.test.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:pack": "npm run build && node scripts/pack-smoke.mjs --save-release",
    "release:publish": "node scripts/release-publish.mjs",
    "release:oidc": "node scripts/verify-oidc.mjs",
    "verify:registry:alpha4": "node scripts/pack-smoke.mjs --registry --registry-version 0.1.0-alpha.4",
    "verify:registry:sveltekit:alpha4": "node scripts/pack-sveltekit.mjs --registry-version 0.1.0-alpha.4",
    "verify:demo:npm": "npm --prefix examples/npm run build && node --test scripts/test/npm-demo-lifecycle.test.mjs",
    "verify:starter": "node scripts/verify-getting-started.mjs",
    "verify:starter:react": "node scripts/verify-framework-starter.mjs --framework react",
    "verify:starter:svelte": "node scripts/verify-framework-starter.mjs --framework svelte",
    "verify:starter:sveltekit": "node scripts/verify-framework-starter.mjs --framework sveltekit",
    "verify:demo:vanilla": "vite build --config examples/vanilla/vite.config.mjs && node --test scripts/test/vanilla-demo-lifecycle.test.mjs",
    "verify:demo:react": "tsc -p examples/react/tsconfig.json && vite build --config examples/react/vite.config.mjs && node --experimental-vm-modules --test scripts/test/react-demo-lifecycle.test.mjs",
    "verify:demo:react:recovery": "node scripts/verify-demo-recovery.mjs --framework react",
    "verify:demo:svelte:recovery": "node scripts/verify-demo-recovery.mjs --framework svelte",
    "verify:demo:sveltekit:recovery": "node scripts/verify-sveltekit-recovery.mjs",
    "build:docs": "node scripts/build-package-docs.mjs",
    "verify:docs": "node scripts/build-package-docs.mjs --check",
    "verify:boundaries": "node scripts/check-package-boundaries.mjs && node --test scripts/test/package-boundaries.test.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs"
  },
  "devDependencies": {
    "@babel/parser": "8",
    "@sveltejs/vite-plugin-svelte": "7",
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "jsdom": "30",
    "react": "19",
    "react-dom": "19",
    "svelte": "5",
    "typescript": "7",
    "vite": "8"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  }
}
