{
  "name": "@0disoft/saylo-svelte",
  "version": "0.1.0-alpha.5",
  "type": "module",
  "description": "Svelte 5 bindings for Saylo with typed context and snapshot-bound translation stores.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/saylo.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://www.npmjs.com/package/@0disoft/saylo-svelte",
  "bugs": {
    "email": "rodisoft1@gmail.com"
  },
  "keywords": [
    "i18n",
    "intl",
    "localization",
    "svelte"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./RichText.svelte": {
      "types": "./dist/rich-text-component.d.ts",
      "svelte": "./dist/RichText.svelte",
      "default": "./dist/RichText.svelte"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"for (const name of ['RichText.svelte', 'rich-text-component.d.ts']) require('node:fs').copyFileSync('src/' + name, 'dist/' + name)\"",
    "test": "node --test test/store.test.mjs test/selectors.test.mjs test/components.test.mjs",
    "typecheck:consumers": "tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@0disoft/saylo-core": "0.1.0-alpha.5"
  },
  "peerDependencies": {
    "svelte": "5"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
