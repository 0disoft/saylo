{
  "name": "@saylo/vite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js" },
    "./server": { "types": "./dist/server-source.d.ts", "import": "./dist/server-source.js" },
    "./virtual": { "types": "./dist/virtual.d.ts" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/virtual.d.ts', 'dist/virtual.d.ts')\"",
    "test": "node --test test/plugin.test.mjs test/client.test.mjs test/lazy.test.mjs test/patch.test.mjs test/production.test.mjs test/server.test.mjs",
    "typecheck:consumers": "tsc -p test/tsconfig.json"
  },
  "dependencies": { "@saylo/core": "0", "@saylo/typegen": "0" },
  "peerDependencies": { "vite": "8" }
}
