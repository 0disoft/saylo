{
  "name": "@0disoft/saylo-vite",
  "version": "0.1.0-alpha.8",
  "type": "module",
  "description": "Vite 8 plugin and dev client that live-update Saylo catalogs without a full reload.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/saylo.git",
    "directory": "packages/vite"
  },
  "homepage": "https://www.npmjs.com/package/@0disoft/saylo-vite",
  "bugs": {
    "email": "rodisoft1@gmail.com"
  },
  "keywords": [
    "i18n",
    "intl",
    "localization",
    "vite",
    "hmr"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server-source.d.ts",
      "import": "./dist/server-source.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts"
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/virtual.d.ts', 'dist/virtual.d.ts')\" && node ../../scripts/build-package-docs.mjs",
    "test": "node --test test/compact-production.test.mjs test/plugin.test.mjs test/client.test.mjs test/lazy.test.mjs test/patch.test.mjs test/push.test.mjs test/wire.test.mjs test/production.test.mjs test/review-build.test.mjs test/build-keys.test.mjs test/auto-keys.test.mjs test/server.test.mjs test/disk-rechecks.test.mjs test/live-registry.test.mjs test/sync-state.test.mjs test/support-report.test.mjs",
    "typecheck:consumers": "tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "7",
    "@0disoft/saylo-core": "0.1.0-alpha.8",
    "@0disoft/saylo-typegen": "0.1.0-alpha.8"
  },
  "peerDependencies": {
    "vite": "8",
    "svelte": "5"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
