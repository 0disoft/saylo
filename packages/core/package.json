{
  "name": "@0disoft/saylo-core",
  "version": "0.1.0-alpha.4",
  "type": "module",
  "description": "Core catalog parsing, schema validation, translation and i18n stores for Saylo.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/saylo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/0disoft/saylo/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/0disoft/saylo/issues"
  },
  "keywords": [
    "i18n",
    "intl",
    "localization",
    "icu",
    "javascript",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/catalog.test.mjs test/simple-message.test.mjs test/translator.test.mjs test/store.test.mjs test/loading.test.mjs test/boot.test.mjs test/snapshot-signature.test.mjs",
    "typecheck:consumers": "tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3",
    "@noble/hashes": "2",
    "intl-messageformat": "12"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
