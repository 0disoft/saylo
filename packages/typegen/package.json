{
  "name": "@0disoft/saylo-typegen",
  "version": "0.1.0-alpha.6",
  "type": "module",
  "description": "TypeScript declaration generator for Saylo base catalogs, usable as a CLI or worker.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/saylo.git",
    "directory": "packages/typegen"
  },
  "homepage": "https://www.npmjs.com/package/@0disoft/saylo-typegen",
  "bugs": {
    "email": "rodisoft1@gmail.com"
  },
  "keywords": [
    "i18n",
    "intl",
    "localization",
    "typegen",
    "cli",
    "typescript"
  ],
  "exports": {
    "./migrate": {
      "types": "./dist/migrate-i18next.d.ts",
      "import": "./dist/migrate-i18next.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./catalog-files": {
      "types": "./dist/catalog-files.d.ts",
      "import": "./dist/catalog-files.js"
    },
    "./review-check": {
      "types": "./dist/review-check.d.ts",
      "import": "./dist/review-check.js"
    }
  },
  "bin": {
    "saylo": "./dist/catalog-cli.js",
    "saylo-typegen": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/migrate.test.mjs test/init.test.mjs test/typegen.test.mjs test/config.test.mjs test/catalog-cli.test.mjs test/catalog-import.test.mjs test/catalog-diff.test.mjs test/catalog-approvals.test.mjs test/catalog-refresh.test.mjs test/catalog-work-context.test.mjs test/catalog-output.test.mjs test/cli-cancellation.test.mjs test/review-write.test.mjs test/replace.test.mjs test/generator-race.test.mjs test/write.test.mjs test/worker.test.mjs test/output-lock.test.mjs",
    "typecheck:consumers": "node test/generate-fixture.mjs && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "7",
    "@0disoft/saylo-core": "0.1.0-alpha.6"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
