{
  "name": "@0disoft/saylo-typegen",
  "version": "0.1.0-alpha.3",
  "type": "module",
  "description": "TypeScript declaration generator for Saylo base catalogs, usable as a CLI or worker.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/saylo.git",
    "directory": "packages/typegen"
  },
  "homepage": "https://github.com/0disoft/saylo/tree/main/packages/typegen#readme",
  "bugs": {
    "url": "https://github.com/0disoft/saylo/issues"
  },
  "keywords": [
    "i18n",
    "intl",
    "localization",
    "typegen",
    "cli",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog-files": {
      "types": "./dist/catalog-files.d.ts",
      "import": "./dist/catalog-files.js"
    }
  },
  "bin": {
    "saylo-typegen": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-test-module-mocks --test test/typegen.test.mjs test/replace.test.mjs test/generator-race.test.mjs",
    "typecheck:consumers": "node test/generate-fixture.mjs && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@0disoft/saylo-core": "0.1.0-alpha.3"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
